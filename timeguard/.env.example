# Neon free (prod / remote): https://neon.tech
DATABASE_URL="postgresql://USER:PASS@HOST/neondb?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Optional: dedicated key for vault AES. Falls back to NEXTAUTH_SECRET.
VAULT_SECRET="change-me-vault-aes-key"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Seed the mr 8 task list only for this account.
# MR8_ACCOUNT_EMAIL=""
